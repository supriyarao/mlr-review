# ---------------------------------------------------------------------------
# Model backend. One factory, three interchangeable backends.
#   fake     - recorded/scripted responses. No network, no key. Used by the
#              test suite and `make eval-offline`; forced on in tests/conftest.py.
#   ollama   - local open-weights model. Free. The development default.
#   anthropic- Claude. Used for the live demo and the committed eval baseline.
# ---------------------------------------------------------------------------
MLR_LLM_BACKEND=ollama

# Model ids per backend. The graph only ever asks for a "strong" or "fast" tier;
# which concrete model that maps to is configuration, not code.
MLR_MODEL_STRONG=qwen2.5:7b
MLR_MODEL_FAST=qwen2.5:7b

# When MLR_LLM_BACKEND=anthropic, use these instead:
#   MLR_MODEL_STRONG=claude-sonnet-5
#   MLR_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Local Ollama server (start it with `ollama serve`).
OLLAMA_BASE_URL=http://localhost:11434

# Where SQLite databases and the Chroma store live.
MLR_DATA_DIR=data

# Optional tracing. No-op when unset.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mlr-agent
